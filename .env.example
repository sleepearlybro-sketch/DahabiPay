PORT=3000
HOST=127.0.0.1
NODE_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=0

# Supabase Project Settings > API. Keep the secret key server-only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QUOTE_SIGNING_SECRET=
QUOTE_TTL_MINUTES=15
STAFF_SESSION_HOURS=12
CUSTOMER_SESSION_DAYS=7

# Use the same custom SMTP provider configured in Supabase Auth.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Dahabi Pay <no-reply@example.com>
