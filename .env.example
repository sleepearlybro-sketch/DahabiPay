# ===========================================================================
# Dahabi Pay configuration
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Nothing here has a working default that moves money: every provider stays
# disabled until its key is present, and unconfigured directions fall through
# to the operator queue rather than failing at payout time.
# ===========================================================================

# --- server ----------------------------------------------------------------
PORT=3000
HOST=127.0.0.1
# public URL used in emailed verification and reset links
PUBLIC_ORIGIN=http://127.0.0.1:3000
NODE_ENV=development
# Set to 1 for the first production seed so customers cannot submit orders
# before payment providers, reserves, email, and compliance are approved.
START_IN_MAINTENANCE=0

# --- database --------------------------------------------------------------
# Railway production: set this on the app service as a reference to the
# Postgres service: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Used only when DATABASE_URL is empty (local development/tests).
DB_FILE=./data/exchangepay.db
DB_POOL_MAX=10
# Railway's private PostgreSQL service does not require client TLS.
DB_SSL=0
DB_SSL_REJECT_UNAUTHORIZED=1

# --- sessions --------------------------------------------------------------
SESSION_DAYS=14
# MUST be 1 in production, or session cookies travel over plain HTTP
COOKIE_SECURE=0

# --- order pipeline --------------------------------------------------------
# minutes a quoted rate is held before the order expires
QUOTE_LOCK_MINUTES=20
# network confirmations before an automated payout fires
PAYOUT_CONFIRMATIONS=2

# --- rate feed -------------------------------------------------------------
# Both defaults are keyless, so live rates work before any credential exists.
RATES_REFRESH_SEC=300
# refuse to quote from a pivot older than this (seconds). Serving a stale
# price is worse than showing "temporarily unavailable".
RATES_MAX_STALE_SEC=3600
RATES_CRYPTO_URL=
RATES_FIAT_URL=

# --- crypto payouts --------------------------------------------------------
# manual = deposits show the static address on the currency row and payouts
# queue for an operator. Set a real provider only when you have keys.
CRYPTO_PROVIDER=manual
CRYPTO_API_KEY=
CRYPTO_API_URL=
# HMAC secret used to verify incoming webhooks. Without it, callbacks are
# logged and dropped, never acted on.
CRYPTO_WEBHOOK_SECRET=

# --- mobile money payouts --------------------------------------------------
MOBILE_PROVIDER=manual
MOBILE_API_KEY=
MOBILE_API_SECRET=
MOBILE_API_URL=
MOBILE_WEBHOOK_SECRET=

# --- email -----------------------------------------------------------------
# With SMTP_HOST empty, emails are written to the log instead of sent, which
# is what you want in development.
# Production mail needs a transport update: the current client lacks STARTTLS.
# DigitalOcean blocks SMTP ports; use an HTTPS email API there (not yet wired).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Dahabi Pay <no-reply@dahabipay.example>

# --- first admin account ---------------------------------------------------
# Used only by the seeder, only when no admin exists yet. Minimum 12
# characters; the seeder refuses to create the account otherwise, so no
# default administrator credential can ship by accident.
ADMIN_LOGIN=admin
ADMIN_EMAIL=admin@dahabipay.example
ADMIN_PASSWORD=

# --- scheduled jobs --------------------------------------------------------
# Shared secret for /api/cron/rates and /api/cron/expire, so an external
# scheduler can drive them. The in-process poller runs them anyway.
CRON_SECRET=

# --- deployment (docker compose) -------------------------------------------
# The domain Caddy will obtain a TLS certificate for, and the address
# Let's Encrypt uses for expiry warnings.
DOMAIN=dahabipay.example
ACME_EMAIL=you@example.com

# --- offsite backups -------------------------------------------------------
# S3-compatible credentials for deploy/backup.sh and Litestream. Any of AWS
# S3, Backblaze B2, Cloudflare R2, DigitalOcean Spaces or Hetzner works.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# where deploy/backup.sh uploads nightly archives, e.g. s3://my-bucket/backups
BACKUP_S3_URI=
