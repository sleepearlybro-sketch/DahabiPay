# =============================================================================
# systemd unit - the no-Docker path.
#
#   sudo cp deploy/exchangepay.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now exchangepay
#   sudo journalctl -u exchangepay -f
# =============================================================================

[Unit]
Description=Dahabi Pay exchanger
Documentation=file:///opt/exchangepay/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=exchangepay
Group=exchangepay
WorkingDirectory=/opt/exchangepay

Environment=NODE_ENV=production
EnvironmentFile=/opt/exchangepay/.env
ExecStart=/usr/bin/node --no-warnings server/index.js

# server/index.js handles SIGTERM: it stops the poller, closes the listener
# and closes the database before exiting
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=5s

# --- hardening ---------------------------------------------------------------
# The process needs to write exactly one directory. Everything else is
# read-only or invisible to it.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/exchangepay
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# a runaway process should not take the box with it
MemoryMax=512M
TasksMax=256

StandardOutput=journal
StandardError=journal
SyslogIdentifier=exchangepay

[Install]
WantedBy=multi-user.target
